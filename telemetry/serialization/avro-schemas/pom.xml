<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.yandex.practicum</groupId>
        <artifactId>serialization</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>avro-schemas</artifactId>

    <dependencies>
        <!-- Avro runtime — оставляем только одну запись без дублирования -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>1.11.3</version>
        </dependency>

        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>schemas</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/avro/</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources</outputDirectory>
                            <stringType>String</stringType>

                            <imports>
                                <import>${project.basedir}/src/main/avro/telemetry/event/DeviceTypeAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/ConditionTypeAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/ConditionOperationAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/ActionTypeAvro.avsc</import>

                                <!-- 2. Простые записи датчиков -->
                                <import>${project.basedir}/src/main/avro/telemetry/event/ClimateSensorAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/LightSensorAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/MotionSensorAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/SwitchSensorAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/TemperatureSensorAvro.avsc</import>

                                <!-- 3. Простые записи хаба — ссылаются на enum'ы -->
                                <import>${project.basedir}/src/main/avro/telemetry/event/DeviceAddedEventAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/DeviceRemovedEventAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/ScenarioConditionAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/DeviceActionAvro.avsc</import>

                                <!-- 4. Составные записи — ссылаются на простые -->
                                <import>${project.basedir}/src/main/avro/telemetry/event/ScenarioAddedEventAvro.avsc</import>
                                <import>${project.basedir}/src/main/avro/telemetry/event/ScenarioRemovedEventAvro.avsc</import>
                            </imports>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>